# Vorlage für /etc/apprologic-kontakt.env auf dem Server.
# Die echte Datei enthält den API-Schlüssel und gehört NICHT ins Git-Repository.

# Sending Key aus Mailgun (Sending → Domain settings → Sending API keys)
MAILGUN_API_KEY=
# Versand-Domain in Mailgun
MAILGUN_DOMAIN=mg.apprologic.de
# eu oder us – je nachdem, in welcher Region die Domain in Mailgun angelegt ist
MAILGUN_REGION=eu

MAIL_TO=info@apprologic.de
MAIL_FROM=ApproLogic Kontaktformular <kontaktformular@mg.apprologic.de>
ALLOWED_ORIGINS=https://www.apprologic.de,https://apprologic.de

# Zum ersten Test auf 1 setzen: Mailgun nimmt die Mail an, stellt sie aber nicht zu
MAILGUN_TEST_MODE=0
